# ─────────────────────────────────────────────────────────────────
#  Close-Scale (Altrium CRM) — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=backend.settings

# Comma-separated allowed hosts, e.g.: localhost,127.0.0.1,yourapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────
# For local Docker: this is auto-built from the values below.
# On Render: DATABASE_URL is injected automatically from the managed DB — leave blank locally.
DATABASE_URL=

# Local Docker Postgres credentials (used by docker-compose.yml)
POSTGRES_DB=closescale
POSTGRES_USER=closescale_user
POSTGRES_PASSWORD=closescale_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── CORS (Frontend URLs) ──────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT Settings ─────────────────────────────────────────────────
# Access token lifetime in minutes
ACCESS_TOKEN_LIFETIME_MINUTES=60
# Refresh token lifetime in days
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email Settings (Brevo SMTP) ──────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-password
DEFAULT_FROM_EMAIL=noreply@closescale.altrium.com
